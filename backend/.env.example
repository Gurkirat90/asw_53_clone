# Copy to backend/.env for local development. Placeholders only; never commit real secrets.
APP_ENV=development
# Relative SQLite paths resolve against backend/.
DATABASE_URL=sqlite:///./data/fiftythree.db

SESSION_COOKIE_NAME=route53_session
SESSION_TTL_SECONDS=43200
# Must be true in production (HTTPS).
SESSION_COOKIE_SECURE=false

DEMO_USER_EMAIL=demo@example.test
DEMO_USER_DISPLAY_NAME=Demo User
DEMO_USER_PASSWORD=change-me-locally

# Comma-separated. Unsafe requests whose Origin header is present and not listed get 403.
TRUSTED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
# Leave empty when using the same-origin /api proxy. Never use a wildcard.
CORS_ALLOWED_ORIGINS=

LOG_LEVEL=INFO
# Defaults to true unless APP_ENV=production. Uncomment to override.
# ENABLE_DOCS=true
