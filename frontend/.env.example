# Copy to .env.local for local development. Never put secrets in NEXT_PUBLIC_* variables.
NEXT_PUBLIC_APP_NAME=Fiftythree
# Server-side target of the /api/* rewrite. Read at `next build` time; set it before building.
API_INTERNAL_BASE_URL=http://127.0.0.1:8000
# Optional: show demo credentials on the login page (e.g. for reviewers of a hosted demo).
# Use only a shareable demo password here; it becomes public. Read at build time.
NEXT_PUBLIC_DEMO_EMAIL=demo@example.test
NEXT_PUBLIC_DEMO_PASSWORD=fiftythree-demo
